# 复制为 ~/.uzqw.dotfiles.env 后填真实值：cp .env.example ~/.uzqw.dotfiles.env
# 每台机器一份，在仓库外，不会进版本库；由 zsh/.zshenv 自动加载
#
# 名字带前缀是为了不与其它工具的 .env 撞车（本机现有惯例都是 ~/.config/<工具>/ 下的）。
#
# 只放"每台机器不同"或"涉密"的变量；各机相同的放仓库配置里。

# export ANTHROPIC_AUTH_TOKEN=your-token-here
# export AGENTMEMORY_SECRET=your-secret-here
# export AGENTMEMORY_URL=http://127.0.0.1:3111
